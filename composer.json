{
	"name": "automattic/jetpack-forms",
	"description": "Jetpack Forms",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"automattic/jetpack-blocks": "^4.0.0",
		"automattic/jetpack-assets": "^5.0.1",
		"automattic/jetpack-wp-build-polyfills": "^0.5.1",
		"automattic/jetpack-connection": "^9.1.0",
		"automattic/jetpack-device-detection": "^4.0.0",
		"automattic/jetpack-external-connections": "^0.2.0",
		"automattic/jetpack-feature-flags": "^0.2.0",
		"automattic/jetpack-jwt": "^0.3.0",
		"automattic/jetpack-logo": "^4.0.0",
		"automattic/jetpack-menu-badges": "^0.2.0",
		"automattic/jetpack-plans": "^0.13.0",
		"automattic/jetpack-status": "^7.0.0",
		"automattic/jetpack-sync": "^5.0.1",
		"automattic/jetpack-admin-ui": "^0.11.1",
		"automattic/jetpack-wp-abilities": "^0.2.0"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/jetpack-connection": "^9.1.0",
		"automattic/phpunit-select-config": "^1.0.11",
		"automattic/wp-feature-api": "@dev"
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-js": "pnpm run test",
		"test-js-coverage": "pnpm run test-coverage",
		"test-php": "@composer phpunit",
		"test-php-coverage": "php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\"",
		"build-production": [
			"pnpm run build-production"
		],
		"build-development": [
			"pnpm run build"
		],
		"watch": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run watch"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"mirror-repo": "Automattic/jetpack-forms",
		"changelogger": {
			"link-template": "https://github.com/automattic/jetpack-forms/compare/v${old}...v${new}"
		},
		"branch-alias": {
			"dev-trunk": "8.0.x-dev"
		},
		"textdomain": "jetpack-forms",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-jetpack-forms.php"
		}
	},
	"config": {
		"allow-plugins": {
			"roots/wordpress-core-installer": true
		}
	}
}
